    {
      "parameters": {
        "jsCode": "const data = $input.first().json.output;\n\nlet teks = `📅 Rencana Konten Harian\\n`;\nteks += `Tanggal: ${data.tanggal}\\n`;\nteks += `Tema: ${data.tema}\\n\\n`;\n\ndata.plan.forEach((item, i) => {\n  teks += `${i + 1}. ${item.time_slot}\\n`;\n  teks += `Judul: ${item.title}\\n`;\n  teks += `Fokus: ${item.focus}\\n\\n`;\n});\n\nreturn [{ json: { pesan: teks } }];"
      },
