      "parameters": {
        "jsCode": "// 1. Ambil data binary foto dari node Get a file\nconst info = $input.first().binary.data;\nconst bufferAwal = await this.helpers.getBinaryDataBuffer(0, 'data');\n\n// 2. Buffer -> Base64 (format yang diminta API upload KIE.ai)\nconst base64 = bufferAwal.toString('base64');\nconst dataUrl = `data:${info.mimeType};base64,${base64}`;\n\n// 3. Base64 -> Buffer (konversi yang diminta tugas)\nconst buffer = Buffer.from(base64, 'base64');\n\n// 4. Buffer -> binary n8n agar bisa dipakai node lain\nconst binaryBaru = await this.helpers.prepareBinaryData(\n  buffer,\n  'foto.jpg',\n  info.mimeType\n);\n\nreturn [{\n  json: {\n    base64Data: dataUrl,\n    fileName: 'foto.jpg',\n    ukuranByte: buffer.length\n  },\n  binary: { data: binaryBaru }\n}];"
      },
